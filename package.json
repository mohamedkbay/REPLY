{
  "name": "reply",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "build:saas": "node server/build.mjs",
    "start:saas": "node --env-file=.saas.env server/start.mjs",
    "test:saas": "node --disable-warning=ExperimentalWarning --test tests/saas.test.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "test:runtime": "node tests/token-runtime.mjs",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "esbuild": "^0.28.1",
    "miniflare": "5.20261019.0-beta",
    "typescript": "latest",
    "wrangler": "4.151.2"
  },
  "description": "Arabic-first merchant inventory and automated product replies, with a bilingual interface and isolated customer workspaces.",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamedkbay/REPLY.git"
  },
  "bugs": {
    "url": "https://github.com/mohamedkbay/REPLY/issues"
  }
}
